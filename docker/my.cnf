[mysqld]
# === Replication / Binlog ===
server-id              = 1
log-bin                = mysql-bin
sync_binlog            = 1
binlog_format          = ROW
binlog_row_image       = FULL
binlog_expire_logs_seconds = 259200

# === SSL / TLS ===
# MySQL 8.0 auto-generates certs in /var/lib/mysql/ on first start.
# We just enforce that every client connection MUST use TLS.
require_secure_transport = ON
tls_version            = TLSv1.3

# === Auth ===
default_authentication_plugin = caching_sha2_password

# === Networking ===
bind-address           = 0.0.0.0
max_connections        = 50
